/**
 * my_config.h.template
 *
 * Copia este archivo a src/my_config.h y edita tus valores.
 * src/my_config.h esta en .gitignore para proteger tus credenciales.
 *
 *   cp my_config.h.template src/my_config.h
 *
 * NOTA: Las credenciales WiFi y la URL del servidor se configuran via el
 * portal cautivo de WiFiManager (no hace falta definirlas aqui). Al primer
 * arranque (o si no conecta), el ESP32 crea un AP "EcowittKiosk" donde puedes
 * configurar hasta 3 redes WiFi y la URL del servidor.
 */

#ifndef MY_CONFIG_H
#define MY_CONFIG_H

// ============================================================================
// WiFiManager - Portal de configuracion
// ============================================================================
// Nombre del AP en modo configuracion (cuando no conecta a ninguna red).
#define AP_NAME             "EcowittKiosk"

// Timeout del portal en segundos (0 = sin timeout, espera indefinidamente).
#define PORTAL_TIMEOUT      180

// URL por defecto del servidor (se puede cambiar en el portal).
#define DEFAULT_API_URL     "http://192.168.1.100:8080"

// ============================================================================
// Refresco del display
// ============================================================================
// Cada cuanto refrescar la imagen del display (ms). 60000 = 1 min.
#define UPDATE_INTERVAL_MS  60000UL

// ============================================================================
// BME280 local (este display como sensor de la pagina 2)
// ============================================================================
// Poner en 0 para deshabilitar la lectura/envio del BME280.
#define BME280_ENABLED  1

// Intervalo de envio del BME280 al servidor, en segundos (minimo 60).
#define REMOTE_STATION_INTERVAL  60

// Offsets de calibracion (se SUMAN a la lectura cruda). Ajustar comparando
// contra una referencia (termometro / la estacion principal). Ej.: si el BME280
// marca 29.7 y el real es 25 -> offset = 25 - 29.7 = -4.7. El BME280 suele leer
// alto por cercania a la electronica; estos offsets lo dejan aproximado.
#define BME280_TEMP_OFFSET     0.0f   // grados C
#define BME280_HUM_OFFSET      0.0f   // %
#define BME280_PRESS_OFFSET    0.0f   // hPa

#endif // MY_CONFIG_H
